{
  "id": "tr-balanced",
  "name": "Türkiye • Ana",
  "description": "Klasik split=2 reçetesini native ters gönderimle uygular; sabit TTL=5 fake yalnız hedefli servislerde çalışır, QUIC açık kalır ve sertifika doğrulamalı Cloudflare DNS-over-HTTPS kullanılır.",
  "badge": "Ana profil • Türkiye",
  "risk": "Medium",
  "recommended": true,
  "arguments": [
    "--tls-split", "2",
    "--tls-split-marker", "none",
    "--reverse-fragments",
    "--no-http-rewrite",
    "--fake-ttl", "5",
    "--fake-repeats", "1",
    "--fake-host-suffix", "roblox.com,rbxcdn.com,rbx.com,discord.com,discord.gg,discordapp.com,discordapp.net,youtube.com,googlevideo.com,ytimg.com",
    "--max-payload", "1500",
    "--allow-quic",
    "--dns-doh", "https://cloudflare-dns.com/dns-query",
    "--dns-doh-address", "1.1.1.1"
  ]
}
