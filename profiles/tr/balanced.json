{
  "id": "tr-balanced",
  "name": "Türkiye • Dengeli",
  "description": "TLS'i ilk bayt ve alan adının ortasından bölüp parçaları ters yollar; geçmiş sıra numaralı tek sahte paket ve sertifika doğrulamalı Cloudflare DNS-over-HTTPS uygular.",
  "badge": "Önerilen • Türkiye",
  "risk": "Medium",
  "recommended": true,
  "arguments": [
    "--tls-split", "1",
    "--tls-split", "2",
    "--tls-split-marker", "midsld",
    "--reverse-fragments",
    "--rewrite-http-host",
    "--no-fake",
    "--fake-seq-offset", "-10000",
    "--fake-repeats", "1",
    "--max-payload", "1500",
    "--allow-quic",
    "--dns-doh", "https://cloudflare-dns.com/dns-query",
    "--dns-doh-address", "1.1.1.1"
  ]
}
