{
  "id": "tr-roblox",
  "name": "Türkiye • Roblox",
  "description": "Yalnız Roblox ve içerik alan adlarında split=2 native ters gönderim, hedefli TTL=5 fake ve sertifika doğrulamalı Cloudflare DNS-over-HTTPS uygular.",
  "badge": "Roblox • Hedefli",
  "risk": "Medium",
  "recommended": false,
  "arguments": [
    "--tls-split", "2",
    "--tls-split-marker", "none",
    "--reverse-fragments",
    "--no-http-rewrite",
    "--fake-ttl", "5",
    "--fake-repeats", "1",
    "--fake-host-suffix", "roblox.com,rbxcdn.com,rbx.com",
    "--max-payload", "1500",
    "--allow-quic",
    "--host-suffix", "roblox.com,rbxcdn.com,rbx.com",
    "--dns-doh", "https://cloudflare-dns.com/dns-query",
    "--dns-doh-address", "1.1.1.1"
  ]
}
