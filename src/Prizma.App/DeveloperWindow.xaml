<Window x:Class="Prizma.App.DeveloperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prizma · Geliştirici" Width="1060" Height="740" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="16"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" Background="Transparent" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#98A5BA" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CanvasBrush}" BorderBrush="#24FFFFFF"
            BorderThickness="1" CornerRadius="16">
        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.88,0.02" GradientOrigin="0.88,0.02" RadiusX="0.82" RadiusY="1.2">
                    <GradientStop Color="#1B223D" Offset="0" />
                    <GradientStop Color="#0D1119" Offset="0.38" />
                    <GradientStop Color="#0A0D13" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#226D7CFF"
                                BorderBrush="#466D7CFF" BorderThickness="1">
                            <TextBlock Text="&lt;/&gt;" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                       Foreground="#BBC2FF" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="GELİŞTİRİCİ" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="MOTOR · ÖLÇÜM · TANILAMA" FontSize="8" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextQuiet}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="—" Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="□"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="×" FontSize="18"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,8,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.75*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.72*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="MOTOR YOLU" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextQuiet}" />
                                <TextBlock Text="{Binding EnginePath, FallbackValue=engine\\Prizma.Engine.exe}"
                                           Style="{StaticResource MonoValue}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="MOTOR DURUMU" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextQuiet}" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusChipText}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="ADAY PROFİL" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextQuiet}" />
                                <TextBlock Text="{Binding Profiles.Count, StringFormat={}{0} strateji yüklü}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.88*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.9*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="1.1*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SurfaceCard}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SEÇİLİ PROFİL" FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Grid.Row="1" Text="{Binding SelectedProfile.Name}"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                               FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedProfile.Arguments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10151E" BorderBrush="#16FFFFFF"
                                                            BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource MonoValue}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="SON GÜNLÜKLER" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextQuiet}" />
                                        <TextBlock Text="CANLI" HorizontalAlignment="Right" FontSize="8"
                                                   FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecentLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoValue}"
                                                               TextWrapping="Wrap" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="BENCHMARK" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextQuiet}" />
                                        <TextBlock Text="En iyi 5 profil" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource AccentButton}" Content="Ölçümü başlat"
                                            Command="{Binding FindRecommendedProfileCommand}"
                                            IsEnabled="{Binding CanRunRecommendation, FallbackValue=True}" />
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                    <Grid>
                                        <TextBlock Text="{Binding BenchmarkProgressText, FallbackValue=Henüz ölçüm yapılmadı}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding BenchmarkProgress, StringFormat={}{0:0}%}"
                                                   HorizontalAlignment="Right" FontSize="9"
                                                   Foreground="{StaticResource TextQuiet}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding BenchmarkProgress}" Maximum="100"
                                                 Style="{StaticResource SlimProgress}" Margin="0,8,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,20,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" FontSize="8" Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Grid.Column="1" Text="PROFİL" FontSize="8" Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Grid.Column="2" Text="PING" FontSize="8" Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Grid.Column="3" Text="MBPS" FontSize="8" Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Grid.Column="4" Text="PUAN" FontSize="8" TextAlignment="Right"
                                               Foreground="{StaticResource TextQuiet}" />
                                </Grid>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BenchmarkTopResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF"
                                                        BorderThickness="1" CornerRadius="12" Padding="12,11" Margin="0,0,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="62" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="8" Background="#206D7CFF"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="#BBC2FF" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProfileName}" FontSize="11" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="8.5" Foreground="{StaticResource TextQuiet}"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="{Binding Grade, StringFormat={}Sınıf {0}}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding SuccessRate, StringFormat={}Başarı %{0:0}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding LatencyMs, StringFormat={}{0:0.0} ms}"
                                                                   FontSize="9.5" Foreground="{StaticResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ThroughputMbps, StringFormat={}{0:0.0}}"
                                                                   FontSize="9.5" Foreground="{StaticResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Score, StringFormat={}{0:0.0}}"
                                                                   FontSize="11" FontWeight="SemiBold" TextAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="4" Text="Ölçüm; erişilebilirlik, gecikme, kararlılık ve aktarım hızını birlikte puanlar."
                                           FontSize="8.5" Foreground="{StaticResource TextQuiet}" TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
