<Window x:Class="Prizma.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prizma" Width="1040" Height="720" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="62" ResizeBorderThickness="6" CornerRadius="16"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource CanvasBrush}" BorderBrush="#24FFFFFF"
            BorderThickness="1" CornerRadius="16">
        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.12,0.08" GradientOrigin="0.12,0.08" RadiusX="0.9" RadiusY="1.15">
                    <GradientStop Color="#19223A" Offset="0" />
                    <GradientStop Color="#0D1119" Offset="0.36" />
                    <GradientStop Color="#0A0D13" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-300,-270,0" IsHitTestVisible="False" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6D7CFF" />
                        <GradientStop Color="#006D7CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="P" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRİZMA" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="YEREL MOTOR · 1.2" FontSize="8.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextQuiet}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32"
                            Content="{Binding DeveloperButtonText, FallbackValue=Geliştirici}"
                            Margin="0,0,10,0" Click="DeveloperButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Border Grid.Column="2" Style="{StaticResource QuietPill}" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="Yönetici modu" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="—" Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="□"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="×" FontSize="18"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,10,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="154" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.38*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <!-- Protection focus -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,6"
                                    Background="#0EFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                    Tag="{Binding IsRunning}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#697487" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusChipText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,18,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding StateTitle}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="42" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateDescription}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="1,10,0,0"
                                               MaxWidth="320" HorizontalAlignment="Left" />
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"
                                        Tag="{Binding IsRunning}" Style="{StaticResource PowerButton}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PowerGlyph}" FontFamily="Segoe UI Symbol"
                                                   FontSize="35" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ActionLabel}" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource QuietPill}">
                                    <TextBlock Text="TLS split" FontSize="9.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource QuietPill}" Margin="8,0,0,0">
                                    <TextBlock Text="Reverse order" FontSize="9.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource QuietPill}" Margin="8,0,0,0">
                                    <TextBlock Text="Yerel · Telemetrisiz" FontSize="9.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Profile sidebar -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="PROFİL" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Text="Ağ stratejisi" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30"
                                        Background="#126D7CFF" BorderBrush="#286D7CFF" BorderThickness="1" CornerRadius="10">
                                    <TextBlock Text="⌁" FontFamily="Segoe UI Symbol" FontSize="15"
                                               Foreground="#AAB2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <ComboBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding CanSelectProfile}"
                                      Style="{StaticResource ProfileComboBox}" Margin="0,20,0,0"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel Grid.Row="2" Margin="1,14,1,0">
                                <Button Style="{StaticResource AccentButton}" Height="42"
                                        Content="{Binding RecommendationButtonText, FallbackValue=✦  Önerilen profili bul}"
                                        Command="{Binding FindRecommendedProfileCommand}"
                                        IsEnabled="{Binding CanRunRecommendation, FallbackValue=True}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                                <TextBlock Text="{Binding RecommendationHint, FallbackValue=Bağlantını ölçer ve en dengeli profili seçer.}"
                                           FontSize="8.5" Foreground="{StaticResource TextQuiet}"
                                           TextAlignment="Center" Margin="0,7,0,0" />

                                <TextBlock Text="{Binding SelectedProfile.Description}" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,14,0,0" />

                                <Border Height="1" Background="#14FFFFFF" Margin="0,20,0,17" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="7" Background="#125ED6A1">
                                        <TextBlock Text="✓" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Kendi motorumuz" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="Üçüncü taraf DPI EXE yok" FontSize="9.5"
                                                   Foreground="{StaticResource TextQuiet}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="7" Background="#126D7CFF">
                                        <TextBlock Text="◌" FontSize="11" Foreground="#AAB2FF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Süreç içinde DNS" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="Ağ ayarını kalıcı değiştirmez" FontSize="9.5"
                                                   Foreground="{StaticResource TextQuiet}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <Grid>
                                    <Border HorizontalAlignment="Left" Style="{StaticResource QuietPill}">
                                        <TextBlock Text="{Binding SelectedProfile.Badge}" FontSize="9.5"
                                                   Foreground="#BBC2FF" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding ServiceStatusText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="8.5" Foreground="{StaticResource TextQuiet}" />
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                            Content="{Binding ServiceActionLabel}" Command="{Binding ManageServiceCommand}"
                                            IsEnabled="{Binding CanManageService}" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="İndir / Güncelle"
                                            Command="{Binding DownloadCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Activity strip -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCard}" Padding="22,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.78*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1.32*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SİSTEM" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextQuiet}" />
                                <TextBlock Text="{Binding HealthTitle}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding HealthDescription}" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                           LineHeight="16" Margin="0,5,18,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#18FFFFFF" />

                            <Grid Grid.Column="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="ETKİNLİK" FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextQuiet}" />
                                    <TextBlock Text="CANLI" HorizontalAlignment="Right" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
                                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="9.5" Foreground="#8792A6"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
