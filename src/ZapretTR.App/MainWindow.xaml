<Window x:Class="ZapretTR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZapretTR" Width="940" Height="680" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#090C14">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.68,0.16" GradientOrigin="0.68,0.16"
                                 RadiusX="0.9" RadiusY="1.05">
                <GradientStop Color="#22243D" Offset="0" />
                <GradientStop Color="#101521" Offset="0.48" />
                <GradientStop Color="#090C14" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-210,0,0,-240" IsHitTestVisible="False" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#663BC9B3" />
                    <GradientStop Color="#003BC9B3" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Margin="28" Background="#B6121723" BorderBrush="#24FFFFFF"
                BorderThickness="1" CornerRadius="28" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#99000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="126" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="ZapretTR" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Türkiye için sade bağlantı koruması"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#0EFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="13" Padding="11,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#55DFAE" Margin="0,0,7,0" />
                            <TextBlock Text="Yönetici" FontSize="11" Foreground="#D9DEEB" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#14FFFFFF" />

                <Grid Grid.Row="2" Margin="0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="0.82*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="360">
                        <TextBlock Text="{Binding StateTitle}" FontSize="32" FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding StateDescription}" Foreground="{StaticResource TextMuted}"
                                   FontSize="13" Margin="18,8,18,22" TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"
                                Style="{StaticResource PowerButton}" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PowerGlyph}" FontSize="40" FontWeight="Light"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ActionLabel}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#16FFFFFF"
                            BorderThickness="1" CornerRadius="20" Padding="22"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="PROFİL" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#7F8BAA" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding CanSelectProfile}"
                                      Style="{StaticResource ProfileComboBox}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding SelectedProfile.Description}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="1,13,1,0" LineHeight="19" />
                            <Border Background="#0EFFFFFF" CornerRadius="9" Padding="9,5"
                                    HorizontalAlignment="Left" Margin="0,15,0,0">
                                <TextBlock Text="{Binding SelectedProfile.Badge}" FontSize="10"
                                           Foreground="#BCC5E1" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="#14FFFFFF" />

                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HealthTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HealthDescription}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="42" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#3506090F" CornerRadius="13" Padding="13,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10" Foreground="#8994AE"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
