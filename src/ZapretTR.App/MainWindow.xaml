<Window x:Class="ZapretTR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZapretTR" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#080B14">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.72,0.18" GradientOrigin="0.72,0.18" RadiusX="0.85" RadiusY="0.9">
                <GradientStop Color="#392C72" Offset="0" />
                <GradientStop Color="#11162A" Offset="0.35" />
                <GradientStop Color="#080B14" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-180,0,0,-220" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5532C8C2" />
                    <GradientStop Color="#0032C8C2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="ZAPRET" FontSize="12" FontWeight="Bold" Foreground="#8995B9" />
                        <TextBlock Text="TR" FontSize="34" FontWeight="Bold" Margin="0,-3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Background="#18FFFFFF" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                            <TextBlock Text="⌂   Ana Sayfa" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="◫   Profiller" Foreground="{StaticResource TextMuted}" Padding="14,11" />
                        <TextBlock Text="⌁   Bağlantı Testi" Foreground="{StaticResource TextMuted}" Padding="14,11" />
                        <TextBlock Text="≡   Günlükler" Foreground="{StaticResource TextMuted}" Padding="14,11" />
                        <TextBlock Text="⚙   Ayarlar" Foreground="{StaticResource TextMuted}" Padding="14,11" />
                    </StackPanel>
                    <Border Grid.Row="3" Background="#1025D9A0" BorderBrush="#3025D9A0" BorderThickness="1"
                            CornerRadius="14" Padding="13">
                        <StackPanel>
                            <TextBlock Text="zapret2 motoru" FontSize="11" Foreground="#8CE4C5" />
                            <TextBlock Text="{Binding EngineVersionText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Günaydın" Foreground="{StaticResource TextMuted}" FontSize="13" />
                        <TextBlock Text="Bağlantın senin kontrolünde." FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#14FFFFFF"
                            BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#52E6B2" Margin="0,0,8,0" />
                            <TextBlock Text="Yönetici modu" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="KORUMA DURUMU" FontSize="11" FontWeight="Bold" Foreground="#8995B9" />
                                <TextBlock Text="{Binding StateTitle}" FontSize="34" FontWeight="SemiBold" Margin="0,9,0,0" />
                                <TextBlock Text="{Binding StateDescription}" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="178" Height="178" Fill="#0FFFFFFF" Stroke="#25FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="132" Height="132">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#6B7DFF" />
                                            <GradientStop Color="#834FE3" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#755CFF" BlurRadius="35" ShadowDepth="0" Opacity="0.7" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding PowerGlyph}" FontSize="46" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="Light" />
                            </Grid>
                            <Button Grid.Row="2" Content="{Binding ActionLabel}" Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding CanToggle}" Style="{StaticResource PrimaryButton}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="AKTİF PROFİL" FontSize="11" FontWeight="Bold" Foreground="#8995B9" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" Margin="0,15,0,15" Height="42" Padding="10,5"
                                      Background="#E9ECF8" Foreground="#101424" BorderThickness="0" />
                            <TextBlock Text="{Binding SelectedProfile.Description}" FontSize="14"
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            <Border Background="#16FFFFFF" CornerRadius="10" Padding="11,7" Margin="0,17,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SelectedProfile.Badge}" FontSize="11" Foreground="#B9C3FF" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GlassCard}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SİSTEM KONTROLÜ" FontSize="11" FontWeight="Bold" Foreground="#8995B9" />
                                <TextBlock Text="{Binding HealthTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" />
                                <TextBlock Text="{Binding HealthDescription}" Foreground="{StaticResource TextMuted}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#0D000000" CornerRadius="13" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                           Foreground="#AAB4D1" TextTrimming="CharacterEllipsis" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
