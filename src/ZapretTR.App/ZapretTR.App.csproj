<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZapretTR.Core\ZapretTR.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZapretTR</AssemblyName>
    <RootNamespace>ZapretTR.App</RootNamespace>
    <Version>0.4.0</Version>
    <Authors>ZapretTR contributors</Authors>
    <Description>Türkiye için birleşik ZapretTR paket işleme arayüzü</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\tr\*.json" Link="profiles\tr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
